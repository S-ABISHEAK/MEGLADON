# Copy to backend/.env for local (non-docker) runs.

# Database — sqlite for local demo, postgres in docker-compose
DATABASE_URL=sqlite:///./megalodon.db
# DATABASE_URL=postgresql://megalodon:megalodon@localhost:5432/megalodon

# Queue
REDIS_URL=redis://localhost:6379/0

# Upload limits
MAX_UPLOAD_BYTES=8589934592

# Frame extraction / inference tuning
DEFAULT_FRAME_SAMPLE_FPS=2.0
INFERENCE_WORKING_RESOLUTION=1024
KEYFRAME_SIMILARITY_THRESHOLD=0.75
QUALITY_REJECT_THRESHOLD=0.35

FORCE_CPU=false
